# Copy to .env and fill in. NEVER commit .env. Secrets live here only.

# --- App ---
APP_NAME="Jan Kalam"
ENVIRONMENT=development        # development | test | production
DEBUG=true

# --- Database ---
# Development/test default is SQLite (no server needed):
DATABASE_URL=sqlite:///./jankalam.db
# Production (Postgres + pgvector):
# DATABASE_URL=postgresql+psycopg://jankalam:CHANGE_ME@localhost:5432/jankalam

# --- AI providers (Phase 4; keys stay server-side, never in the Android app) ---
AI_PROVIDER=none              # none | anthropic | gemini | openai  (none => offline mock)
AI_API_KEY=
AI_MODEL_CHEAP=               # e.g. a small model for classification/tagging
AI_MODEL_STRONG=              # e.g. gemini-2.5-flash  or  claude-3-5-sonnet-latest
AI_PRICE_IN_PER_MTOK=0        # USD per 1M input tokens (for cost tracking)
AI_PRICE_OUT_PER_MTOK=0       # USD per 1M output tokens

# --- Ingestion ---
INGEST_POLL_INTERVAL_SECONDS=900
INGEST_USER_AGENT="JanKalamBot/0.1 (+https://jankalam.app)"
