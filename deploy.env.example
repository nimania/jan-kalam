# Copy this file to ".env" (in the same folder as docker-compose.yml) and fill it in.
#   cp deploy.env.example .env
# NEVER commit the real .env.

# --- Database ---
# Pick a long random password (letters+numbers). It's used internally only.
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# --- Public address (for Caddy / HTTPS) ---
# If you have a domain pointed at this server:  news.example.com   (auto HTTPS)
# For a first test with just the server IP:       :80             (plain HTTP)
SITE_ADDRESS=:80

# --- AI provider (runs on THIS server, outside Iran) ---
# none  => free offline mock (works with zero setup, placeholder synthesis)
# gemini or anthropic => real Persian synthesis (needs a key)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL_STRONG=gemini-2.5-flash
AI_PRICE_IN_PER_MTOK=0
AI_PRICE_OUT_PER_MTOK=0

# --- Ingestion ---
INGEST_POLL_INTERVAL_SECONDS=900     # how often the worker fetches + processes news
